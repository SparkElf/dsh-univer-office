{
  "name": "@dsh-local/univer",
  "version": "0.1.0",
  "description": "DSH × Univer integration plugin: univer CLI/daemon management (node half) + in-app spreadsheet preview UI (client half). One-command installer for DeepSeek Harness.",
  "type": "module",
  "main": "./lib/index.js",
  "bin": {
    "univer-dsh": "./scripts/install.js"
  },
  "files": [
    "lib",
    "scripts",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
